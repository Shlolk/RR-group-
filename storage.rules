rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Public read for web assets
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // User profile images — owner only
    match /users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 // 5MB
        && request.resource.contentType.matches('image/.*');
    }

    // Career applications — applicant uploads, staff reads
    match /career-applications/{allPaths=**} {
      allow read, write: if isStaff();
      allow create: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/.*');
    }

    // Other documents — staff only
    match /documents/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isStaff() {
      return request.auth != null && (
        request.auth.token.super_admin == true ||
        request.auth.token.admin == true ||
        request.auth.token.manager == true ||
        request.auth.token.staff == true
      );
    }
  }
}