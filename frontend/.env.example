# ===== RR GROUP Frontend Environment Variables =====
# Copy this file to .env.local and fill in real values.

# Backend API origin. Next.js proxies /api/... to this URL.
BACKEND_URL=http://localhost:5000
# BASE_API_URL=http://localhost:5000   # optional alias

# --- Firebase (client config — public values are safe) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Razorpay (public key id — safe to expose) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Contact / WhatsApp ---
# Digits only with country code, e.g. 919820012345
NEXT_PUBLIC_WHATSAPP_NUMBER=